<UserControl x:Class="FH6GarageEditor.UpdaterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="22,18,22,20" MaxWidth="1500">
      <TextBlock Text="更新器" Style="{StaticResource PageTitle}"/>
      <Border Style="{StaticResource Panel}" Margin="0,15,0,18" Padding="16">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource Muted}"
                     VerticalAlignment="Center" Margin="0,0,9,0"/>
            <TextBlock x:Name="UpdateStatus" Text="正在准备检查更新…" VerticalAlignment="Center"
                       AutomationProperties.LiveSetting="Polite"/>
          </StackPanel>
          <WrapPanel Margin="0,13,0,0">
            <Button x:Name="CheckUpdate" Content="检查更新" Click="CheckClick" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
            <Button x:Name="InstallUpdate" Content="下载更新并重启" Click="InstallClick" IsEnabled="False"
                    Visibility="Collapsed" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
            <Button x:Name="CancelUpdate" Content="取消下载" Click="CancelClick" Visibility="Collapsed" Margin="0,0,8,0"/>
            <Button Content="GitHub 发布页" Click="OpenReleasePage" Margin="0"/>
          </WrapPanel>
          <ProgressBar x:Name="DownloadProgress" Visibility="Collapsed" Margin="0,13,0,0" Height="6"
                       Minimum="0" Maximum="100" Foreground="{StaticResource Accent}"/>
          <TextBlock x:Name="UpdateNote" Margin="0,10,0,0" TextWrapping="Wrap"
                     Visibility="Collapsed" Foreground="{StaticResource Muted}"/>
        </StackPanel>
      </Border>
      <DataGrid x:Name="Versions" Style="{StaticResource UpdateTable}" Margin="0,0,0,20"
                AutomationProperties.Name="本地和线上版本">
        <DataGrid.Columns>
          <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="116"/>
          <DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="116"/>
          <DataGridTextColumn Header="发布时间" Binding="{Binding Date}" Width="152"/>
          <DataGridTextColumn Header="发布信息" Binding="{Binding Title}" Width="*" ElementStyle="{StaticResource TableText}"/>
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock Text="发布记录" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,9"/>
      <DataGrid x:Name="ReleaseHistory" Style="{StaticResource UpdateTable}" AutomationProperties.Name="GitHub 发布记录">
        <DataGrid.Columns>
          <DataGridTextColumn Header="版本" Binding="{Binding VersionText}" Width="116"/>
          <DataGridTextColumn Header="发布者" Binding="{Binding Author}" Width="164" ElementStyle="{StaticResource TableText}"/>
          <DataGridTextColumn Header="发布时间" Binding="{Binding PublishedText}" Width="152"/>
          <DataGridTextColumn Header="发布信息" Binding="{Binding Title}" Width="*" ElementStyle="{StaticResource TableText}"/>
        </DataGrid.Columns>
      </DataGrid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
