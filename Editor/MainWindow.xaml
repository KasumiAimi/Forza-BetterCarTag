<Window x:Class="FH6GarageEditor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:FH6GarageEditor"
    Title="更好的车辆标签" Icon="GarageEditor.ico" Width="1360" Height="850" MinWidth="930" MinHeight="660"
    WindowStartupLocation="CenterScreen" Background="{StaticResource Workspace}" Foreground="{StaticResource Ink}"
    FontFamily="Microsoft YaHei UI" FontSize="14">
  <Grid Background="{StaticResource Workspace}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="124"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Border Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,1,0">
      <DockPanel Margin="6,16,7,13" LastChildFill="False">
        <TextBlock x:Name="AppVersion" DockPanel.Dock="Bottom" HorizontalAlignment="Center"
                   Foreground="{StaticResource Muted}" FontSize="12"/>
        <StackPanel DockPanel.Dock="Top">
          <Image x:Name="HeaderPortrait" Source="HeaderPortrait.png" Width="88" Height="88"
                 HorizontalAlignment="Center" Margin="0,0,0,18" RenderOptions.BitmapScalingMode="HighQuality"/>
          <RadioButton x:Name="GarageNav" Style="{StaticResource NavigationItem}" GroupName="MainPage" IsChecked="True"
                       Checked="ShowGarage" AutomationProperties.Name="车库" FontSize="16" MinHeight="46">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="20" Width="26" VerticalAlignment="Center"/>
              <TextBlock Text="车库" VerticalAlignment="Center"/>
            </StackPanel>
          </RadioButton>
          <RadioButton x:Name="UpdaterNav" Style="{StaticResource NavigationItem}" GroupName="MainPage"
                       Checked="ShowUpdater" AutomationProperties.Name="更新器" FontSize="16" MinHeight="46">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="20" Width="26" VerticalAlignment="Center"/>
              <TextBlock Text="更新器" VerticalAlignment="Center"/>
              <Ellipse x:Name="UpdateIndicator" Width="6" Height="6" Fill="{StaticResource Accent}" Margin="6,0,0,0"
                       VerticalAlignment="Center" Visibility="Collapsed"/>
            </StackPanel>
          </RadioButton>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1">
      <Grid x:Name="GaragePage" Margin="22,18,22,16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,15">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="我的车辆" Style="{StaticResource PageTitle}"/>
            <Button x:Name="ManageTagsButton" Content="标签管理" Click="ManageTagsClick" Margin="18,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <ComboBox x:Name="Profiles" Width="192" DisplayMemberPath="Display" SelectionChanged="ProfileChanged" Margin="0,0,8,0" AutomationProperties.Name="车库档案"/>
            <Button Content="刷新车库" Click="RefreshClick"/>
            <Button Content="选择存档" Click="OpenSaveClick"/>
            <Button x:Name="ApplyButton" Content="应用到游戏" Click="ApplyClick" Style="{StaticResource PrimaryButton}" IsEnabled="False"/>
          </StackPanel>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="13,8" Margin="0,0,0,12">
          <StackPanel>
            <DockPanel LastChildFill="True">
              <TextBlock x:Name="Count" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="12,0,0,0"/>
              <CheckBox x:Name="FavoriteOnly" DockPanel.Dock="Right" Content="仅显示收藏"
                        Foreground="White" VerticalAlignment="Center" Margin="14,0,0,0"
                        Checked="FilterChanged" Unchecked="FilterChanged"/>
              <TextBlock DockPanel.Dock="Left" Text="制造商" VerticalAlignment="Center" Margin="0,0,9,0"/>
              <ComboBox x:Name="Makes" DockPanel.Dock="Left" Width="176" SelectionChanged="FilterChanged" Margin="0,0,14,0" AutomationProperties.Name="制造商"/>
              <TextBlock DockPanel.Dock="Left" Text="等级" VerticalAlignment="Center" Margin="0,0,9,0"/>
              <ComboBox x:Name="ClassFilter" DockPanel.Dock="Left" Width="100" SelectionChanged="FilterChanged" Margin="0,0,14,0" AutomationProperties.Name="车辆等级"/>
              <TextBlock DockPanel.Dock="Left" Text="搜索" VerticalAlignment="Center" Margin="0,0,9,0"/>
              <TextBox x:Name="Search" TextChanged="FilterChanged" VerticalContentAlignment="Center" Padding="8" MinHeight="34"
                       AutomationProperties.Name="搜索车型或车库编号"/>
            </DockPanel>
            <WrapPanel Margin="0,8,0,0">
              <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                <TextBlock Text="赛事类型" VerticalAlignment="Center" Margin="0,0,9,0"/>
                <ComboBox x:Name="RaceFilter" Width="144" DisplayMemberPath="Name" SelectionChanged="FilterChanged"
                          AutomationProperties.Name="筛选赛事类型"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                <TextBlock Text="性能倾向" VerticalAlignment="Center" Margin="0,0,9,0"/>
                <ComboBox x:Name="StyleFilter" Width="132" DisplayMemberPath="Name" SelectionChanged="FilterChanged"
                          AutomationProperties.Name="筛选性能倾向"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="强度" VerticalAlignment="Center" Margin="0,0,9,0"/>
                <ComboBox x:Name="StrengthFilter" Width="152" DisplayMemberPath="Name" SelectionChanged="FilterChanged"
                          AutomationProperties.Name="筛选强度"/>
              </StackPanel>
              <Button x:Name="ClearFilters" Content="清空筛选" Click="ClearFiltersClick" Margin="14,0,0,0"
                      VerticalAlignment="Center"/>
            </WrapPanel>
          </StackPanel>
        </Border>
        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource Panel}" Margin="0,0,12,0" Padding="13">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock x:Name="DetailsName" Text="选择一台车" FontSize="24" FontWeight="Bold" TextWrapping="Wrap"/>
                <TextBlock x:Name="DetailsMeta" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,8"/>
                <Border Background="#EEF0F4" Height="122" CornerRadius="4" ClipToBounds="True">
                  <Image x:Name="DetailsImage" Stretch="Uniform"/>
                </Border>
                <TextBlock x:Name="ImageSource" Foreground="{StaticResource Muted}" Margin="0,4,0,0" FontSize="12"/>
                <TextBlock x:Name="DetailsSpecs" Margin="0,9,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                <TextBlock Text="赛事类型" Margin="0,16,0,5" FontWeight="Bold"/>
                <ComboBox x:Name="RaceTag" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="TagsChanged" IsEnabled="False" AutomationProperties.Name="赛事类型"/>
                <TextBlock Text="性能倾向" Margin="0,13,0,5" FontWeight="Bold"/>
                <ComboBox x:Name="StyleTag" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="TagsChanged" IsEnabled="False" AutomationProperties.Name="性能倾向"/>
                <TextBlock Text="强度" Margin="0,13,0,5" FontWeight="Bold"/>
                <ComboBox x:Name="StrengthTag" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="TagsChanged" IsEnabled="False" AutomationProperties.Name="强度"/>
              </StackPanel>
            </ScrollViewer>
          </Border>
          <ScrollViewer x:Name="CarScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                        SizeChanged="CarViewportChanged">
            <UniformGrid x:Name="Cards" VerticalAlignment="Top"/>
          </ScrollViewer>
        </Grid>
        <DockPanel Grid.Row="3" Margin="0,11,0,0">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button x:Name="Previous" Content="上一页" Click="PreviousClick"/>
            <TextBlock x:Name="PageLabel" VerticalAlignment="Center" Margin="10,0"/>
            <Button x:Name="Next" Content="下一页" Click="NextClick"/>
          </StackPanel>
          <Button x:Name="GameDirectoryButton" DockPanel.Dock="Right" Content="游戏目录" Click="ChooseGameDirectoryClick"
                  Margin="0,0,10,0"/>
          <TextBlock x:Name="Status" Text="正在读取本机车库…" VerticalAlignment="Center" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
        </DockPanel>
      </Grid>
      <local:UpdaterPage x:Name="UpdatePane" Visibility="Collapsed"/>
    </Grid>
  </Grid>
</Window>
